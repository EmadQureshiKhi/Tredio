{
  "name": "tredio",
  "version": "0.1.0",
  "private": true,
  "description": "Trade the world's attention on NEAR: an AI radar finds trends, a TEE oracle scores them 0 to 100 on chain, and passkey accounts trade the index.",
  "author": "Emad Qureshi",
  "license": "MIT",
  "packageManager": "pnpm@10.7.0",
  "engines": {
    "node": ">=22",
    "bun": ">=1.3"
  },
  "scripts": {
    "build:contracts": "contracts/scripts/build.sh",
    "test:contracts": "cd contracts && cargo test --workspace",
    "test": "pnpm -r --if-present test",
    "typecheck": "pnpm -r --if-present typecheck",
    "lint": "pnpm -r --if-present lint",
    "dev": "bun scripts/dev.ts",
    "verify": "bun scripts/verify.ts",
    "security": "bun scripts/security.ts",
    "coverage:contracts": "cd contracts && cargo llvm-cov --workspace --exclude tredio-sandbox-tests --exclude tredio-test-publisher --summary-only"
  },
  "devDependencies": {
    "@noble/curves": "2.2.0",
    "@noble/hashes": "2.0.1",
    "@tredio/autopilot": "workspace:*",
    "@tredio/chain": "workspace:^",
    "@tredio/contracts": "workspace:^",
    "@tredio/custody": "workspace:*",
    "@tredio/hyperliquid": "workspace:*",
    "@tredio/intents": "workspace:*",
    "@types/bun": "1.3.1",
    "near-kit": "0.20.2",
    "typescript": "5.9.3"
  }
}
