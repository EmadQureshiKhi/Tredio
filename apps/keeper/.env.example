# Tredio keeper: series, listings, settlements, liquidations, funding, retirements, coins and expired orders.
PORT=4200
NEAR_NETWORK=testnet
NEAR_RPC_URLS=
DEPLOYMENT_JSON=
# The sending account and its key. With KEEPER_GAS_KEY_LANES above 0 the key must be a gas key
# with that many nonces (scripts/gas-keys.ts adds one), so actions go out in parallel.
KEEPER_ACCOUNT_ID=tredio-keeper.testnet
KEEPER_PRIVATE_KEY=ed25519:your-keeper-secret-key
KEEPER_GAS_KEY_LANES=0
# Series windows to open (seconds): 24 h and 7 d, plus testnet's short test window if wanted (900).
SERIES_WINDOWS=86400,604800
# Create a trend coin on a bonding curve for every active trend.
COINS=on
SETTLE_DELAY_SEC=30
SCAN_INTERVAL_SEC=15
MAX_ACTIONS_PER_SCAN=12
# A live trend without an oracle update for this long raises an alert.
STALE_ALERT_SEC=900
# The backend's rotation endpoint (trends rotating out go stale on purpose).
ROTATION_URL=http://localhost:4000/v1/rotation
MIN_BALANCE_NEAR=1
