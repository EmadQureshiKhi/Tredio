# Demo traders the team runs on testnet (README.md). The personas file comes from scripts/activity-setup.ts.
PORT=4900
NEAR_NETWORK=testnet
NEAR_RPC_URLS=
FASTNEAR_API_KEYS=
BACKEND_URL=http://localhost:4000
PERSONAS_FILE=internal/keys/activity-personas.json
# The funder setup created (internal/keys/activity-funder.json); it tops up the personas' gas keys.
FUNDER_ACCOUNT_ID=activity.tredio-treasury.testnet
FUNDER_PRIVATE_KEY=
# The last UTC day the personas act, and how many actions all of them take a day.
ACTIVITY_UNTIL=2026-11-26
ACTIONS_PER_DAY=150
GAS_KEY_MIN_NEAR=0.25
GAS_KEY_TOPUP_NEAR=0.3
