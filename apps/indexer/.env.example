# Tredio indexer: the NEP-297 events of the Tredio contracts, from FastNEAR's APIs into Postgres.
# Copy to .env and fill in. Empty optional values count as unset.

# testnet or mainnet; picks deployments/<network>.json and the API hosts.
NEAR_NETWORK=testnet
# #mainnet: set mainnet once deployments/mainnet.json is live (MAINNET.md); the .testnet accounts below become their .near twins.
# txs: FastNEAR's transactions API (no key needed). blocks: every block from neardata (needs a key
# to keep up with testnet).
INDEXER_SOURCE=txs
# Postgres. TLS follows the URL (add ?sslmode=require for a hosted database).
DATABASE_URL=postgres://tredio:password@localhost:5432/tredio
# Schema for every table; the backend reads the same one (its INDEXER_SCHEMA).
INDEXER_SCHEMA=indexer
# First block to read when there is no cursor yet. Empty: the deployments file's startBlock, or
# the testnet deployment block (276376358).
START_BLOCK=
# Transactions API; empty means https://tx.test.fastnear.com (testnet) or https://tx.main.fastnear.com.
TX_API_URL=https://tx.test.fastnear.com
# FastNEAR API keys for both feeds, comma-separated, taken in turn; a refused one is dropped while
# others remain. TX_API_KEY or NEARDATA_API_KEY, when set, wins for its own feed.
FASTNEAR_API_KEYS=
# FastNEAR subscription key for the transactions API, sent as a bearer token.
TX_API_KEY=
# Requests a minute; empty means 55 without a key (it answers 429 past about 60), 600 per key with keys.
TX_API_RPM=
# Accounts that relay owner requests, comma-separated, listed every cycle like the contracts.
RELAYER_ACCOUNT_ID=tredio-relayer.testnet
# Blocks kept between the API's committed head and the cursor.
TX_SAFETY_BLOCKS=10
# How far below the cursor listings start, for transactions whose first touch came late.
TX_LOOKBACK_BLOCKS=600
# Most blocks one cycle covers while catching up.
TX_BACKFILL_WINDOW=100000
# Trend coins and user accounts listed per cycle, in turn.
TX_SLOW_PER_CYCLE=2
# Shortest time between cycles at the head.
TX_POLL_MS=3000
# A transaction still running after this many blocks is given up, with a warning.
TX_PENDING_MAX_BLOCKS=3000
# Block source of INDEXER_SOURCE=blocks; empty means https://<network>.neardata.xyz.
NEARDATA_URL=https://testnet.neardata.xyz
# FastNEAR subscription key, sent as a bearer token. Without one neardata allows about 30
# requests a minute per IP, while testnet makes about 105 blocks a minute.
NEARDATA_API_KEY=
# Requests a minute, retries and head lookups included; empty means 28 without a key, 600 per key with keys.
NEARDATA_RPM=
# Block requests in flight.
NEARDATA_CONCURRENCY=3
# Pause before asking neardata again for a height it does not have yet.
POLL_MS=1000
# Deployments file; empty means deployments/<network>.json at the repo root.
DEPLOYMENTS_FILE=
# Health server: GET /health (200 while the indexed block is under MAX_LAG_SEC old) and GET /live.
PORT=4700
MAX_LAG_SEC=60
# /live answers 503 when the loop has not made progress or retried for this long.
LIVE_TIMEOUT_SEC=300
LOG_LEVEL=info

# Only for `bun test`: a database the tests may write (each run uses its own throwaway schema).
TEST_DATABASE_URL=postgres://tredio:password@localhost:5432/tredio_test
# 1 runs the live smoke tests against testnet neardata and the transactions API.
INDEXER_LIVE=
