# Tredio indexer: the NEP-297 events of the Tredio contracts, from FastNEAR's neardata block
# stream into Postgres. Copy to .env and fill in. Empty optional values count as unset.

# testnet or mainnet; picks deployments/<network>.json and the neardata host.
NETWORK=testnet
# Postgres. TLS follows the URL (add ?sslmode=require for a hosted database).
DATABASE_URL=postgres://tredio:password@localhost:5432/tredio
# Schema for every table; the backend reads the same one (its INDEXER_SCHEMA).
INDEXER_SCHEMA=indexer
# First block to read when there is no cursor yet. Empty: the deployments file's startBlock, or
# the testnet deployment block (276376358).
START_BLOCK=
# Block source; empty means https://<network>.neardata.xyz.
NEARDATA_URL=https://testnet.neardata.xyz
# FastNEAR subscription key, sent as a bearer token. Without one neardata allows about 30
# requests a minute per IP, while testnet makes about 105 blocks a minute.
NEARDATA_API_KEY=
# Requests a minute, retries and head lookups included; empty means 28 without a key, 600 with one.
NEARDATA_RPM=
# Block requests in flight.
NEARDATA_CONCURRENCY=3
# Deployments file; empty means deployments/<network>.json at the repo root.
DEPLOYMENTS_FILE=
# Health server: GET /health (200 while the indexed block is under MAX_LAG_SEC old) and GET /live.
PORT=4600
MAX_LAG_SEC=60
# /live answers 503 when the loop has not made progress or retried for this long.
LIVE_TIMEOUT_SEC=300
# Pause before asking again for a height neardata does not have yet.
POLL_MS=1000
LOG_LEVEL=info

# Only for `bun test`: a database the tests may write (each run uses its own throwaway schema).
TEST_DATABASE_URL=postgres://tredio:password@localhost:5432/tredio_test
# 1 runs the live smoke test against testnet neardata.
INDEXER_LIVE=
