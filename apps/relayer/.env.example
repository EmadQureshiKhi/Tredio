# Tredio relayer: pays for passkey accounts, owner requests, session gas keys and wallet meta-transactions.
PORT=4100
NEAR_NETWORK=testnet
# RPC endpoints tried in order; FastNEAR and NEAR's own by default.
NEAR_RPC_URLS=
# FastNEAR API keys, comma-separated (server keys, never browser ones): requests take them in turn,
# ahead of the endpoints above, and a refused key sits out for ten minutes.
FASTNEAR_API_KEYS=
# A deployment file's JSON, to point at contracts other than the bundled deployment.
DEPLOYMENT_JSON=
# The paying account and its key. With RELAYER_GAS_KEY_LANES above 0 the key must be a gas key
# with that many nonces (scripts/gas-keys.ts adds one), so transactions go out in parallel.
RELAYER_ACCOUNT_ID=tredio-relayer.testnet
RELAYER_PRIVATE_KEY=ed25519:your-relayer-secret-key
RELAYER_GAS_KEY_LANES=0
# The backend's activation ticket key (its public key, which the backend logs at start).
# Required on mainnet; on testnet an empty value accepts sign-ups without a ticket.
ACTIVATION_TICKET_SIGNER=
# NEAR a new account receives (storage, registrations, its first session's gas allowance), and the
# session gas key top-up: refilled to the target once it falls under the minimum.
CREATE_DEPOSIT_NEAR=0.4
SESSION_GAS_TARGET_NEAR=0.35
SESSION_GAS_MIN_NEAR=0.31
# Before a session key is added, the account's NEAR beyond storage is topped up to the target when below the minimum.
SESSION_STORAGE_MIN_NEAR=0.15
SESSION_STORAGE_TARGET_NEAR=0.2
MIN_BALANCE_NEAR=2
# Budgets, in memory (they reset on restart).
ACCOUNTS_PER_HOUR=30
ACCOUNTS_PER_DAY=150
OWNER_CALLS_PER_ACCOUNT_PER_HOUR=30
TOPUPS_PER_SESSION_PER_DAY=3
TOPUPS_PER_ACCOUNT_PER_DAY=12
STORAGE_TOPUPS_PER_ACCOUNT_PER_DAY=4
META_TX_PER_ACCOUNT_PER_HOUR=120
NEAR_PER_HOUR=15
# App origins allowed by CORS, comma-separated, and proxies in front (Caddy: 1).
FRONTEND_URL=http://localhost:3000
TRUSTED_PROXY_HOPS=0
