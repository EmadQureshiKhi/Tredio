# Tredio market maker: quotes Up/Down markets on the Tredio book.
PORT=4300
NEAR_NETWORK=testnet
# #mainnet: set mainnet once deployments/mainnet.json is live (MAINNET.md); the .testnet accounts below become their .near twins.
NEAR_RPC_URLS=
# FastNEAR API keys, comma-separated (server keys, never browser ones): requests take them in turn,
# ahead of the endpoints above, and a refused key sits out for ten minutes.
FASTNEAR_API_KEYS=
DEPLOYMENT_JSON=
MM_ACCOUNT_ID=tredio-mm.testnet
MM_PRIVATE_KEY=ed25519:your-market-maker-secret-key
MM_GAS_KEY_LANES=0
QUOTE_WINDOWS=86400,604800
# Series quoted at once, 24h ones first: one per live slot (the API's MAX_LIVE_TRENDS).
MAX_SERIES=24
# Complete sets minted per quoted series as ask inventory, and USDC kept on the book for bids.
SETS_PER_SERIES=100
MARGIN_USDC=1500
# The ladder: first level HALF_SPREAD from fair value, LEVELS levels LEVEL_STEP apart, LEVEL_TOKENS each,
# skewed up to MAX_SKEW against inventory (largest at INVENTORY_LIMIT net tokens).
HALF_SPREAD=0.03
LEVEL_STEP=0.01
LEVELS=2
LEVEL_TOKENS=20
MAX_SKEW=0.03
INVENTORY_LIMIT=60
# Re-quote when a level drifts REQUOTE_TICKS (0.001 each); drift-only re-quotes at most every MIN_REQUOTE_SEC.
REQUOTE_TICKS=15
MIN_REQUOTE_SEC=120
STOP_BEFORE_EXPIRY_SEC=300
ARB_MIN_EDGE=0.005
ARB_MAX_TOKENS=200
TICK_SEC=20
MIN_BALANCE_NEAR=1
# Any value stops quoting and pulls every order; so does creating KILL_SWITCH_FILE.
KILL_SWITCH=
KILL_SWITCH_FILE=
# Order ids live only in this file: deleting it strands resting orders.
STATE_FILE=.mm-state.json
