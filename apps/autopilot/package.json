{
  "name": "@tredio/autopilot-executor",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Runs Autopilot rules and copy-trading: opens and closes Hyperliquid perps when a trend's attention moves, and mirrors Hyperliquid traders, through each account's own guarded session.",
  "author": "Emad Qureshi",
  "license": "MIT",
  "scripts": {
    "start": "bun src/index.ts",
    "dev": "bun run --watch src/index.ts",
    "seal-keys": "bun scripts/seal-keys.ts",
    "order": "bun scripts/order.ts",
    "test": "bun test",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@noble/curves": "2.2.0",
    "@noble/hashes": "2.0.1",
    "@tredio/autopilot": "workspace:*",
    "@tredio/chain": "workspace:*",
    "@tredio/contracts": "workspace:*",
    "@tredio/hyperliquid": "workspace:*",
    "hono": "4.12.18",
    "postgres": "3.4.9",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/bun": "1.3.1",
    "typescript": "5.9.3"
  }
}
