# Tredio Autopilot and copy-trading executor: Hyperliquid perps through each account's guarded session.
PORT=4400
NEAR_NETWORK=testnet
# RPC endpoints tried in order; FastNEAR and NEAR's own by default.
NEAR_RPC_URLS=
# A deployment file's JSON, to point at contracts other than the bundled deployment.
DEPLOYMENT_JSON=
# The backend's database: the executor reads and writes its Autopilot tables (the backend owns the schema).
DATABASE_URL=postgres://tredio:your-password@localhost:5432/tredio
# The relayer, which tops up session gas keys.
RELAYER_URL=http://localhost:4100
# Opens the grants the app sealed to this executor (base64url PKCS#8 P-256). Make a pair with
# `bun run seal-keys`; the public half goes in the backend's AUTOPILOT_SEAL_PUBLIC_KEY and is also
# logged at start. Without it, only the bot trades.
AUTOPILOT_SEAL_PRIVATE_KEY=your-seal-private-key
# The Tredio bot: its own Tredio account and the secret of that account's Autopilot session key
# (label autopilot, Hyperliquid scope only, a gas key). Leave both empty to run without the bot.
AUTOPILOT_BOT_ACCOUNT=your-bot-account
AUTOPILOT_BOT_SESSION_KEY=ed25519:your-bot-session-secret
TICK_SEC=15
# Worst accepted fill, basis points from the mark (at most 100: the account guard allows 2% from Tredio's mark).
SLIPPAGE_BPS=50
# Pause a rule after this many failed orders in a row.
MAX_CONSECUTIVE_FAILURES=3
# How old a Nansen smart-money reading may be and still count (seconds).
NETFLOW_MAX_AGE_SEC=43200
# Hyperliquid's base taker fee, booked when a fill's own fee is not visible yet (basis points).
HL_TAKER_FEE_BPS=4.5
# Ask the relayer to top up a session gas key below this (NEAR); a session call prepays 0.3.
SESSION_GAS_MIN_NEAR=0.31
# Any value halts openings from the environment, on top of the admin kill switch.
KILL_SWITCH=
