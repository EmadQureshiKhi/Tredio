# Tredio's attention check on the NEAR AI Agent Market (https://market.near.ai): answers hires for a topic.
PORT=4800
NEAR_NETWORK=testnet
# #mainnet: set mainnet once deployments/mainnet.json is live (MAINNET.md); the registry account follows the deployment.
# RPC endpoints tried in order; FastNEAR and NEAR's own by default.
NEAR_RPC_URLS=
# FastNEAR API keys, comma-separated (server keys, never browser ones): requests take them in turn,
# ahead of the endpoints above, and a refused key sits out for ten minutes.
FASTNEAR_API_KEYS=
# A deployment file's JSON, to point at contracts other than the bundled deployment.
DEPLOYMENT_JSON=
# Tredio's API, where topics resolve and the evidence comes from; PUBLIC_API_URL is the same API as
# callers reach it, for the verification links in an answer (BACKEND_URL when empty), for example
# https://api.tredio.bid once it is hosted.
BACKEND_URL=http://localhost:4000
PUBLIC_API_URL=
APP_URL=https://app.tredio.bid
# Find the oracle report behind the newest checkpoint and check its signature (FastNEAR's
# transactions API, NEAR_TX_API_URL, by default https://tx.test.fastnear.com on testnet).
VERIFY_ORACLE_REPORT=on
NEAR_TX_API_URL=
# The market and the agent's API token (aat_ and 32 hex): minted by the agent's owner on the
# website, or written here by `bun scripts/list.ts --publish` when it registers the agent.
MARKET_URL=https://market.near.ai
MARKET_API_TOKEN=
AGENT_MARKET_AGENT_ID=
# The webhook secret set on the listing (32 characters or more). Empty: the worker only polls.
MARKET_WEBHOOK_SECRET=
# Polling the assignments (the market asks for 30 to 60 s; 15 s keeps a webhook-less call inside
# the caller's 60 s wait).
POLL_INTERVAL_SEC=15
# The price per call in USDC (the listing's per_call plan quotes it), the escrow tokens taken (plans
# are priced in USD and A2A calls paid 1:1 in USDC; the market's examples show both), and
# the daily cap: calls accepted per UTC day, paid and free test runs together. A hire under the
# price or over the cap is declined and the caller is refunded (an A2A caller is never charged).
PRICE_USDC=0.05
ACCEPT_TOKENS=USDC,USD
DAILY_CAP=200
FREE_TESTS_PER_DAY=5
MAX_CONCURRENT=4
MAX_ATTEMPTS=3
WORK_TIMEOUT_SEC=45

# The listing (scripts/list.ts only). WORKER_PUBLIC_URL is the worker's public HTTPS origin for
# the webhook (the market refuses loopback and private addresses).
AGENT_MARKET_HANDLE=tredio-attention
AGENT_MARKET_NAME=Tredio attention check
AGENT_MARKET_CATEGORY=data
AGENT_MARKET_EMAIL=
SLA_SECONDS=120
WORKER_PUBLIC_URL=
# Only the owner sets this, to run `bun scripts/list.ts --publish`.
AGENT_MARKET_PUBLISH=
