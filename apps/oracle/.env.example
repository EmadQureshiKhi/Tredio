# Tredio oracle: measures trends, lists new ones, posts Hyperliquid marks and submits signed reports.
PORT=4600
NEAR_NETWORK=testnet
NEAR_RPC_URLS=
DEPLOYMENT_JSON=
# The account that submits reports (it pays gas; the signature is what the registry trusts).
ORACLE_ACCOUNT_ID=tredio-oracle.testnet
ORACLE_PRIVATE_KEY=ed25519:your-oracle-account-secret-key
# local: this process computes and signs with REPORT_SIGNING_KEY. outlayer: the enclave build computes and signs (docs/tee.md).
ORACLE_MODE=local
REPORT_SIGNING_KEY=ed25519:your-report-signing-secret-key
OUTLAYER_CONTRACT=outlayer.testnet
OUTLAYER_WASM_URL=https://test.fastfs.io/your-account/outlayer.testnet/your-build-sha256.wasm
OUTLAYER_WASM_HASH=your-build-sha256
OUTLAYER_MAX_SECONDS=60
OUTLAYER_SECRETS_PROFILE=
OUTLAYER_SECRETS_ACCOUNT=
# The backend and its ORACLE_TOKEN (local mode reads candidates and readings with it).
BACKEND_URL=http://localhost:4000
BACKEND_TOKEN=your-backend-oracle-token
RUN_INTERVAL_SEC=60
MAX_SAMPLES_PER_RUN=24
MAX_CANDIDATES_PER_RUN=2
MAX_LIVE_TRENDS=24
HEARTBEAT_SEC=420
DEVIATION_BPS=100
MIN_CREATE_INDEX_POINTS=5
MARK_ASSETS=BTC,ETH,SOL,NEAR,HYPE
MIN_BALANCE_NEAR=2
