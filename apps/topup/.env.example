# Tredio top-up: keeps service accounts, gas keys and contracts funded from one treasury.
PORT=4500
NEAR_NETWORK=testnet
# #mainnet: set mainnet once deployments/mainnet.json is live (MAINNET.md); the .testnet accounts below become their .near twins.
NEAR_RPC_URLS=
# FastNEAR API keys, comma-separated (server keys, never browser ones): requests take them in turn,
# ahead of the endpoints above, and a refused key sits out for ten minutes.
FASTNEAR_API_KEYS=
DEPLOYMENT_JSON=
TREASURY_ACCOUNT_ID=tredio-treasury.testnet
TREASURY_PRIVATE_KEY=ed25519:your-treasury-secret-key
# The treasury never spends below its floor, and reports itself low below TREASURY_LOW_NEAR.
TREASURY_FLOOR_NEAR=2
TREASURY_LOW_NEAR=10
# NEAR targets, highest priority first: name=account@min/target, or name=account/ed25519:<key>@min/target
# for a gas key the treasury funds directly. Add every new sending account and gas key here. A gas
# key reserves 0.3 NEAR for every 300 Tgas call in flight, so keep its minimum above 0.3 NEAR per lane.
TARGETS=relayer=tredio-relayer.testnet@2/5,keeper=tredio-keeper.testnet@1/3,mm=tredio-mm.testnet@1/3
# Testnet only: USDC targets, minted by an account the test USDC contract lists as a minter.
USDC_TARGETS=mm-usdc=tredio-mm.testnet@2000/10000
USDC_MINTER_ACCOUNT_ID=tredio-faucet.testnet
USDC_MINTER_PRIVATE_KEY=ed25519:your-minter-secret-key
# The most one target receives a day, how often balances are checked, and the wait between refills of one target.
DAILY_CAP_NEAR=10
DAILY_CAP_USDC=20000
CHECK_INTERVAL_SEC=120
COOLDOWN_SEC=600
# on: plan and report, send nothing.
DRY_RUN=off
STATE_FILE=.topup-state.json
