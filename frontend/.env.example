# Copy to .env.local and fill in. Every NEXT_PUBLIC_ value is inlined into the bundle at build time,
# so set them before `npm run build`. Leave optional values commented out rather than empty: an
# empty value replaces the default.

# Tredio backend and relayer. The browser calls both directly, so the backend's FRONTEND_URL and the
# relayer's ALLOWED_ORIGINS must list this app's origin.
NEXT_PUBLIC_BACKEND_URL=http://localhost:4000
NEXT_PUBLIC_RELAYER_URL=http://localhost:4100
NEXT_PUBLIC_APP_URL=http://localhost:3000

# The Tredio bot account Autopilot shows and copies.
# NEXT_PUBLIC_TREDIO_BOT_ADDRESS=

# Passkey relying party id. Defaults to the page's hostname. In production it is the registrable
# domain (tredio.bid), so passkeys work on every subdomain; it never changes once people sign up.
# NEXT_PUBLIC_PASSKEY_RP_ID=
