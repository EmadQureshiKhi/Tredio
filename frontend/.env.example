# Copy to .env.local and fill in. Every NEXT_PUBLIC_ value is inlined into the bundle at build time,
# so set them before `npm run build`. Leave optional values commented out rather than empty: an
# empty value replaces the default.

# NEAR network: testnet (the default) or mainnet. Picks the contracts from deployments/<network>.json.
NEXT_PUBLIC_NEAR_NETWORK=testnet

# Tredio API and relayer. The browser calls both directly, so the API's CORS list and the relayer's
# FRONTEND_URL must include this app's origin.
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_RELAYER_URL=http://localhost:4100

# The public origin of this app: share links, link cards and the passkey prompt use it.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Passkey relying party id. Defaults to the page's hostname. In production it is the registrable
# domain (tredio.bid), so passkeys work on every subdomain; it never changes once people sign up.
# NEXT_PUBLIC_PASSKEY_RP_ID=tredio.bid

# The NEAR account of the Tredio bot that Autopilot shows and lets people copy: the same account as
# the API's AUTOPILOT_BOT_ACCOUNT. Unset, the app shows no bot.
# NEXT_PUBLIC_TREDIO_BOT_ACCOUNT=<the API's AUTOPILOT_BOT_ACCOUNT>

# NEAR RPC endpoints the browser reads from, comma-separated, tried in order with failover.
# Defaults to the deployment's RPC and the network's public one.
# NEXT_PUBLIC_NEAR_RPC_URLS=https://test.rpc.fastnear.com,https://rpc.testnet.near.org
