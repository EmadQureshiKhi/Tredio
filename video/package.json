{
  "name": "tredio-launch-video",
  "private": true,
  "type": "module",
  "description": "Tredio's launch film for X, built as code with Remotion from real captures of the app",
  "license": "MIT",
  "scripts": {
    "capture": "node scripts/capture.mjs",
    "music": "node scripts/music.mjs",
    "stills": "node scripts/stills.mjs",
    "render": "node scripts/render.mjs",
    "render:landscape": "node scripts/render.mjs Film",
    "render:vertical": "node scripts/render.mjs Vertical",
    "studio": "remotion studio src/index.ts",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@remotion/bundler": "4.0.529",
    "@remotion/cli": "4.0.529",
    "@remotion/renderer": "4.0.529",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "remotion": "4.0.529"
  },
  "devDependencies": {
    "@types/react": "19.3.0",
    "playwright-core": "1.64.0",
    "typescript": "5.9.3"
  }
}
