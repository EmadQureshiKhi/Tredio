# Public endpoints, behind Cloudflare's proxy. Service health stays on the internal network, where the API's status page reads it.
{
	servers {
		# Cloudflare's edge (https://www.cloudflare.com/ips): a request from these ranges carries the visitor's
		# address in CF-Connecting-IP; from anywhere else, the socket's address counts and the header is ignored.
		trusted_proxies static 173.245.48.0/20 103.21.244.0/22 103.22.200.0/22 103.31.4.0/22 141.101.64.0/18 108.162.192.0/18 190.93.240.0/20 188.114.96.0/20 197.234.240.0/22 198.41.128.0/17 162.158.0.0/15 104.16.0.0/13 104.24.0.0/14 172.64.0.0/13 131.0.72.0/22 2400:cb00::/32 2606:4700::/32 2803:f800::/32 2405:b500::/32 2405:8100::/32 2a06:98c0::/29 2c0f:f248::/32
		client_ip_headers CF-Connecting-IP
	}
}

# X-Forwarded-For carries one entry, the visitor's address, so the API and relayer run with TRUSTED_PROXY_HOPS=1.
(service) {
	encode zstd gzip
	reverse_proxy {args[0]} {
		header_up X-Forwarded-For {client_ip}
	}
}

api.tredio.bid {
	import service backend:4000
}

relay.tredio.bid {
	encode zstd gzip
	reverse_proxy relayer:4100
}
