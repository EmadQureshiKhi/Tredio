# Tredio backend: trend radar, measurement collector and app API.
# Copy to .env and fill in. Empty optional values count as unset.

PORT=4000
LOG_LEVEL=info
# Postgres. Local databases skip TLS; hosted ones require it.
DATABASE_URL=postgres://tredio:password@localhost:5432/tredio
# Only for `bun test`: a database the tests may truncate.
TEST_DATABASE_URL=postgres://tredio:password@localhost:5432/tredio_test
# The indexer's database and schema; the same database works. Without it the
# history endpoints (track records, trade history, trader leaderboard, trend stats) answer 503.
INDEXER_DATABASE_URL=postgres://tredio:password@localhost:5432/tredio_indexer
INDEXER_SCHEMA=indexer
# Comma-separated app origins allowed by CORS (the app, and the admin panel on 3001 locally).
FRONTEND_URL=http://localhost:3000
# Comma-separated website origins allowed by CORS for the Mainnet waitlist form only (production:
# https://tredio.bid). The landing page runs on 3004 locally.
LANDING_URL=http://localhost:3004
# Proxies in front of the backend that append the client's address to X-Forwarded-For. Every IP
# rate limit takes the entry this many positions from the right; anything further left is written
# by the client. 0 (no proxy) ignores the header and uses the socket address. Behind Caddy: 1.
TRUSTED_PROXY_HOPS=0

# NEAR: the network and its deployment (deployments/<network>.json is bundled), and RPC endpoints
# tried in order (FastNEAR and NEAR's own by default). DEPLOYMENT_JSON overrides the bundled file.
NEAR_NETWORK=testnet
# #mainnet: set mainnet once deployments/mainnet.json is live (MAINNET.md); the .testnet accounts below become their .near twins.
NEAR_RPC_URLS=
# FastNEAR API keys, comma-separated (server keys, never browser ones): requests take them in turn,
# ahead of the endpoints above, and a refused key sits out for ten minutes.
FASTNEAR_API_KEYS=
DEPLOYMENT_JSON=

# Bearer token the oracle sends to /v1/oracle/*. Generate with: openssl rand -base64 32
ORACLE_TOKEN=
# NEAR accounts allowed to call /v1/admin/* (NEP-413 requests signed by a full-access key), comma-separated.
ADMIN_ACCOUNTS=
# Signs admin session tokens (openssl rand -hex 32); unset means a new key, and new sign-ins, per start.
ADMIN_SESSION_SECRET=

# Elfa API keys, comma-separated, with their daily and monthly credit budgets. Key i calls only
# through route i of ELFA_PROXIES (an http(s) URL, one per key); a key without a route is unused.
ELFA_API_KEYS=
ELFA_PROXIES=
# Keyless sources may retry once through those routes after a refusal, up to this much a month.
PROXY_FALLBACK_MB_PER_MONTH=300
ELFA_DAILY_CREDITS_PER_KEY=100
ELFA_MONTHLY_CREDITS_PER_KEY=950
# Read each key's month-to-date usage and plan from Elfa on start, in the background, one key at a
# time (one credit each). Off by default: usage is counted locally.
ELFA_SYNC_USAGE=off
# Elfa calls go out one at a time, a random gap apart; each key rests between its own uses, and its
# daily credits open hour by hour. Key checks go one key at a time, a random gap apart.
ELFA_MIN_GAP_SEC=20
ELFA_MAX_GAP_SEC=90
ELFA_KEY_MIN_GAP_SEC=600
ELFA_HOURLY_SLACK=2
ELFA_CHECK_GAP_MIN_SEC=30
ELFA_CHECK_GAP_MAX_SEC=90

# Nansen API keys, comma-separated. The free plan tops up to 10 credits a day; netflow costs 5.
NANSEN_API_KEYS=
NANSEN_DAILY_CREDITS_PER_KEY=10
NANSEN_CHAINS=all

# Wikimedia allows 10 requests a minute without contact details in the User-Agent and 200 with a
# URL or email, for example in production: TredioAttentionIndex/1.0 (https://tredio.bid)
WIKIMEDIA_USER_AGENT=TredioAttentionIndex/1.0 (attention markets)

# AI review on NEAR AI Cloud's verifiable models (TEE), tried in order, cheapest first. Every answer
# is checked with verifyResponse() and its signed evidence is stored (GET /v1/reviews/<hash>).
# Without a key the radar proposes nothing and pasted links answer 502.
NEARAI_API_KEY=
NEARAI_API_BASE=https://cloud-api.near.ai/v1
NEARAI_MODELS=z-ai/glm-5.3-flash,deepseek-ai/DeepSeek-V4.1-Flash-1017,z-ai/glm-5.3
# AI provider requests per UTC day (fallbacks count), shared by the radar and pasted links. Links
# pause once half is spent, so the radar always keeps the other half.
AI_DAILY_CALLS=400

# Radar: every run, Elfa trending tokens, CoinGecko's and GeckoTerminal's trending lists and
# Bluesky's trending topics (keyless, each fetched at most every 10 minutes); Elfa narratives
# (5 credits, paid keys only) every NARRATIVES_EVERY runs; Wikipedia's most-read articles once a day.
RADAR_INTERVAL_SEC=7200
NARRATIVES_EVERY=6
# Radar runs between Elfa trending-token calls (1 credit each). With a single free key (about 32
# credits a day) raise it, for example to 6, so the collector's live trends keep most credits.
ELFA_TOKENS_EVERY=1
AUTO_APPROVE_CONFIDENCE=0.8
# Crypto candidates reach the oracle once smart money confirms them; match the oracle's minimum netflow.
CRYPTO_CONFIRM_NETFLOW_USD=100000

# Collector cadence and the shortest refresh per source. Elfa's interval stretches with the number
# of trends so the day's credits last.
COLLECT_INTERVAL_SEC=60
ELFA_REFRESH_SEC=7200
# GDELT: live trends every GDELT_REFRESH_SEC, candidates every GDELT_CANDIDATE_REFRESH_SEC.
GDELT_REFRESH_SEC=1800
GDELT_CANDIDATE_REFRESH_SEC=3600
NANSEN_REFRESH_SEC=14400
WIKIPEDIA_REFRESH_SEC=21600
# Keyless: Bluesky (one search per trend, a second apart) and Hacker News (up to three searches per trend).
BLUESKY_REFRESH_SEC=1800
HN_REFRESH_SEC=3600

# Autopilot: the executor's public sealing key (apps/autopilot prints it), the Tredio bot's own
# account, and backtest costs (Hyperliquid's base taker fee and a slippage allowance, basis points).
AUTOPILOT_SEAL_PUBLIC_KEY=
AUTOPILOT_BOT_ACCOUNT=
# #mainnet: the NEAR Intents Agent API partner key (partners.near-intents.org): Autopilot grants on an agent
# the account's passkey owns. Server side only; testnet policy wallets need nothing here.
AGENT_API_KEY=
AGENT_API_URL=
HL_TAKER_FEE_BPS=4.5
BACKTEST_SLIPPAGE_BPS=5
HISTORY_INTERVAL_SEC=60

# Paid private signals: the secret the weekly viewing keys derive from (64 hex characters,
# `openssl rand -hex 32`). The Autopilot executor needs the same value to copy signals. Empty turns signals off.
SIGNALS_SECRET=

# NEAR Intents 1Click for any-chain deposits and withdrawals (mainnet; testnet shows dry quotes).
# A partner JWT from the Partner Dashboard (https://partners.near-intents.org/home, a distribution channel key) makes every
# quote confidential (1Click refuses confidential quotes without it); a refused JWT sits out ten minutes while quotes go out public.
ONECLICK_API_BASE=https://1click.chaindefuser.com
ONECLICK_JWT=

# Live slots (equal to the oracle's maxLiveTrends) and rotation: a full board swaps one faded trend
# at a time for a stronger approved candidate. Community picks: candidates at least
# PICK_MIN_WATCHERS accounts wait on go first, PICK_MAX at a time.
MAX_LIVE_TRENDS=24
ROTATION=on
ROTATION_MIN_AGE_SEC=129600
ROTATION_FADE_RATIO=0.6
ROTATION_TIMEOUT_SEC=21600
ROTATION_LIST_GRACE_SEC=1200
ROTATION_STALE_WINDOW_SEC=21600
ROTATION_COOLDOWN_SEC=3600
PICK_MIN_WATCHERS=3
PICK_MAX=3

# Web Push. Generate keys with: bunx web-push generate-vapid-keys. The subject is a mailto: or https: contact.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=https://tredio.bid

# Signs activation tickets (ed25519:<base58 secret key>): the relayer creates an account only with
# one (set its ACTIVATION_TICKET_SIGNER to this key's public key, which the backend logs at start).
# A ticket goes to a new account while the caller's address and everyone together are within these caps.
ACTIVATION_TICKET_KEY=
ACTIVATION_TICKETS_PER_IP_PER_HOUR=3
ACTIVATION_TICKETS_PER_IP_PER_DAY=10
ACTIVATION_TICKETS_PER_HOUR=30
ACTIVATION_TICKETS_PER_DAY=150

# The public status view checks these health endpoints, one name=url entry per service,
# comma-separated (relayer 4100, keeper 4200, market-maker 4300, autopilot 4400, topup 4500,
# oracle 4600, indexer 4700); the admin system view reads the same endpoints in detail.
STATUS_SERVICES=keeper=http://localhost:4200/health
# The admin system view (GET /v1/admin/system) also checks these, which the public view never
# names (name=url, comma-separated). An entry in either list may add |-separated flags for the
# admin system view: optional (its outage is a warning, not critical) and staleMin=<minutes>
# (it reads as stalled after that long without work; keeper, market-maker, autopilot and topup
# have defaults), for example worker=http://localhost:4600/health|optional|staleMin=60.
ADMIN_SERVICES=
ORACLE_STALE_SEC=900

# x402 pay-per-call API (x402 v2, NEAR "exact" scheme): the account paid (empty: the deployment's
# treasury) and the prices in USDC atomic units (6 decimals): full index history, a rule backtest.
X402_PAYEE=
X402_PRICE=10000
X402_BACKTEST_PRICE=20000
# The relayer that submits payers' signed transfers and pays their gas: an account and a
# full-access key nothing else signs with. The paid routes are off without them.
X402_RELAYER_ACCOUNT=
X402_RELAYER_KEY=

# off disables the radar and collector loops (API only).
BACKGROUND=on
