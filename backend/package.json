{
  "name": "@tredio/backend",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "Tredio radar, measurement collector and app API: proposes trends to the TEE oracle, reviews them on NEAR AI Cloud and serves the app. It never writes prices.",
  "scripts": {
    "dev": "bun run --hot src/index.ts",
    "start": "bun src/index.ts",
    "migrate": "bun src/db/migrate.ts",
    "test": "bun test/run.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@tredio/autopilot": "workspace:*",
    "hono": "4.12.18",
    "pino": "10.3.1",
    "postgres": "3.4.9",
    "web-push": "3.6.7",
    "zod": "4.6.5",
    "@tredio/contracts": "workspace:*",
    "@tredio/chain": "workspace:*",
    "@tredio/hyperliquid": "workspace:*",
    "@tredio/intents": "workspace:*",
    "@nearai/inference-sdk": "0.2.1",
    "near-kit": "0.20.2",
    "@noble/curves": "2.2.0",
    "@noble/hashes": "2.0.1"
  },
  "devDependencies": {
    "@types/bun": "1.3.1",
    "@types/web-push": "3.6.4",
    "typescript": "5.9.3"
  }
}
