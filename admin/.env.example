# Copy to .env.local and fill in. NEXT_PUBLIC_ values are inlined into the bundle at build time,
# so set them before `npm run build`.

# Tredio backend origin. The browser calls it directly, so the backend's FRONTEND_URL must list
# this panel's origin (http://localhost:3001 in development).
NEXT_PUBLIC_BACKEND_URL=http://localhost:4000

# The NEAR network admin wallets sign in on (testnet or mainnet).
NEXT_PUBLIC_NEAR_NETWORK=testnet

# Optional, comma-separated NEAR accounts expected to be admins. Only a hint on the sign-in screen:
# the backend checks its own ADMIN_ACCOUNTS on every request, so this list grants nothing.
NEXT_PUBLIC_ADMIN_ACCOUNTS=
